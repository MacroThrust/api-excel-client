# Azure AD / Microsoft Identity Platform
MSAL_CLIENT_ID=your-azure-app-client-id
MSAL_AUTHORITY=https://login.microsoftonline.com/common

# Authentik OAuth2 Provider
AUTHENTIK_BASE_URL=https://authentik.example.com
