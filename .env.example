AUTHENTIK_TOKEN_ENDPOINT=https://authentik.example.com/application/o/token/
AUTHENTIK_AUTHORIZE_ENDPOINT=https://authentik.example.com/application/o/authorize/

# API Configuration
API_BASE_URL=https://api.example.com/v1

# Add-in Hosting
ADDIN_HOST=https://your-addin-host.example.com
