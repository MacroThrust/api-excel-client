{
  "name": "mt-excel-addin",
  "version": "1.0.0",
  "description": "Excel Add-in with custom functions (MT.* UDFs) using Microsoft Account authentication via Authentik OAuth2",
  "private": true,
  "scripts": {
    "build:docs": "node scripts/build-docs.js",
    "test:docs": "node --test scripts/build-user-guide.test.js",
    "build": "npm run build:docs && webpack --mode production",
    "build:dev": "npm run build:docs && webpack --mode development",
    "build:openapi": "node scripts/generate-openapi-functions.js",
    "dev": "npm run build:docs && webpack serve --mode development",
    "start": "webpack serve --mode development --open",
    "lint": "eslint src/**/*.ts",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:production": "npm run build:docs && ADDIN_HOST=${ADDIN_HOST:-https://macrothrust.github.io/api-excel-client} NODE_ENV=production webpack --mode production && office-addin-manifest validate dist/manifest.xml --production"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@macrothrust/api-client": "file:..\\api-client",
    "office-addin-manifest": "^1.13.6"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/office-js": "^1.0.598",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.4",
    "custom-functions-metadata-plugin": "^1.7.2",
    "html-webpack-plugin": "^5.6.7",
    "marked": "^15.0.12",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
